APP_NAME=PanelShelf
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-string
AUTH_ENABLED=true
APP_USERNAME=admin
APP_PASSWORD=change-me
DATABASE_URL=sqlite:////data/app.db
LIBRARY_ROOT=/data/library
CACHE_ROOT=/data/cache
MEDIA_ROOT=/data/media
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=600
PAGE_CACHE_MAX_DIMENSION=2400

# Optional PostgreSQL mode:
# DATABASE_URL=postgresql+psycopg://panelshelf:panelshelf@postgres:5432/panelshelf
# POSTGRES_DB=panelshelf
# POSTGRES_USER=panelshelf
# POSTGRES_PASSWORD=panelshelf
